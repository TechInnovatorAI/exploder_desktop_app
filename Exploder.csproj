<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net9.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
	</PropertyGroup>

	<ItemGroup>
		<Resource Include="Infrastructure\Assets\**\*" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.VisualBasic" Version="10.3.0" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Views\ProjectOpenWindow.xaml.cs">
			<SubType>Code</SubType>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="TestConsole\**\*" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="Views\4bad495b-31ac-44ed-868f-e8ab7f8b8435.png" />
	</ItemGroup>

	<ItemGroup>
	  <Resource Include="Views\4bad495b-31ac-44ed-868f-e8ab7f8b8435.png" />
	</ItemGroup>

	<Target Name="PreBuild" BeforeTargets="PreBuildEvent">
		<Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(ProjectDir)Properties\Kill-WpfApp.ps1&quot;" />
	</Target>

</Project>
